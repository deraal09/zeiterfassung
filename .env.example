PORT=3000
# Pflicht: zufaelliger, geheimer String zum Signieren der Session-Cookies.
# Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ohne gesetzten Wert startet die App nicht (bewusst - mit einem bekannten
# Vorgabewert liessen sich fremde Sessions faelschen).
SESSION_SECRET=
TZ=Europe/Berlin

# Pflicht: Schluessel zur Verschluesselung sensibler Datenbankfelder
# (Taetigkeitsbeschreibungen), 32 Byte als 64 Hex-Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Getrennt von der Datenbank-Datei aufbewahren (z. B. Passwort-Tresor der
# Schule) - ohne diesen Schluessel sind die verschluesselten Felder auch bei
# einem Server-/Hosterwechsel oder Zugriff auf eine DB-Kopie nicht lesbar.
# NIEMALS aendern, wenn bereits verschluesselte Daten existieren - sonst
# lassen sich diese nicht mehr entschluesseln!
ENCRYPTION_KEY=

# LDAP-Verbindung
LDAP_URL=ldaps://ldap.example.org:636
# Service-Account, mit dem Benutzer gesucht werden (Lesezugriff genuegt)
LDAP_BIND_DN=cn=reader,dc=schule,dc=de
LDAP_BIND_PASSWORD=geheim
# Suchbasis fuer Lehrkraefte
LDAP_BASE_DN=ou=people,dc=schule,dc=de
# {{username}} wird durch den eingegebenen Benutzernamen ersetzt
# Fuer Active Directory z. B. (sAMAccountName={{username}})
LDAP_USER_FILTER=(uid={{username}})
LDAP_USERNAME_ATTR=uid
LDAP_DISPLAY_NAME_ATTR=cn
LDAP_EMAIL_ATTR=mail
# Fuer Active Directory typischerweise:
# LDAP_USER_FILTER=(sAMAccountName={{username}})
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_DISPLAY_NAME_ATTR=displayName

# Direkt-Bind-Modus: Anmeldung bindet direkt mit der Nutzerkennung + Passwort,
# OHNE Service-Account (LDAP_BIND_DN/LDAP_BIND_PASSWORD werden dann ignoriert).
# {{username}} wird durch den eingegebenen Benutzernamen ersetzt.
# Bei Active Directory oft die einfachste, zuverlaessigste Variante:
# LDAP_BIND_USER_TEMPLATE={{username}}@schule.de
# oder mit NetBIOS-Domaene:
# LDAP_BIND_USER_TEMPLATE=SCHULE\{{username}}

# Nur noetig bei ldaps:// mit internem/selbstsigniertem Zertifikat:
# Pfad zur PEM-Datei der internen CA (empfohlen)
# LDAP_TLS_CA_PFAD=/pfad/zur/interne-ca.pem
# Zertifikatspruefung abschalten (nur als Notloesung in vertrauenswuerdigen Netzen)
# LDAP_TLS_REJECT_UNAUTHORIZED=false

# Komma-getrennte Liste von LDAP-Benutzernamen mit Admin-Rechten in der App
ADMIN_USERNAMES=admin1,admin2

# Optional: Pfad zur SQLite-Datenbank (relativ zum Projektverzeichnis)
DB_PATH=./data/zeiterfassung.db
