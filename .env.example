PORT=3000
SESSION_SECRET=bitte-aendern-in-produktion
TZ=Europe/Berlin

# LDAP-Verbindung
LDAP_URL=ldaps://ldap.example.org:636
# Service-Account, mit dem Benutzer gesucht werden (Lesezugriff genuegt)
LDAP_BIND_DN=cn=reader,dc=schule,dc=de
LDAP_BIND_PASSWORD=geheim
# Suchbasis fuer Lehrkraefte
LDAP_BASE_DN=ou=people,dc=schule,dc=de
# {{username}} wird durch den eingegebenen Benutzernamen ersetzt
# Fuer Active Directory z. B. (sAMAccountName={{username}})
LDAP_USER_FILTER=(uid={{username}})
LDAP_USERNAME_ATTR=uid
LDAP_DISPLAY_NAME_ATTR=cn
LDAP_EMAIL_ATTR=mail

# Komma-getrennte Liste von LDAP-Benutzernamen mit Admin-Rechten in der App
ADMIN_USERNAMES=admin1,admin2

# Optional: Pfad zur SQLite-Datenbank (relativ zum Projektverzeichnis)
DB_PATH=./data/zeiterfassung.db
