<!DOCTYPE html>
<html lang="de">
<head>
  <title>Bereiche – Admin – Zeiterfassung</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <%- include('../partials/admin-subnav', { aktiv: 'bereiche', pfad: '/admin/bereiche' }) %>

    <h1>Bereiche <span class="meta">Schuljahr <%= schuljahr %></span></h1>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <% if (ok) { %><p class="alert alert-success"><%= ok %></p><% } %>

    <section class="panel">
      <h2>Neuen Bereich anlegen</h2>
      <p class="hint">
        Bereiche gliedern die Personen, die Ausgleichsstunden erhalten (z. B. nach
        Abteilung). Beim Zuweisen wird jeder Zuweisung ein Bereich zugeordnet; je Bereich
        gibt es einen eigenen Ausdruck. Sie gelten pro Schuljahr und lassen sich ins
        nächste übernehmen (siehe "Pools").
      </p>
      <form method="post" action="/admin/bereiche" class="entry-form">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="schuljahr" value="<%= schuljahr %>">
        <input type="text" name="name" placeholder="Name, z. B. Technik" maxlength="100" required>
        <button type="submit" class="btn btn-start">Anlegen</button>
      </form>
    </section>

    <section class="panel">
      <h2>Bereiche</h2>
      <% if (bereiche.length === 0) { %>
        <p class="empty-state">Für <%= schuljahr %> gibt es noch keinen Bereich.</p>
      <% } else { %>
        <% bereiche.forEach(b => { %>
          <form id="bereich-edit-<%= b.id %>" method="post" action="/admin/bereiche/<%= b.id %>/edit">
            <%- include('../partials/csrf') %>
          </form>
        <% }) %>
        <div class="table-scroll">
        <table class="entries-table">
          <thead><tr><th>Bereich</th><th>Personen</th><th>Ausgleichsstunden</th><th>Unterschrift</th><th></th></tr></thead>
          <tbody>
            <% bereiche.forEach(b => { %>
              <tr>
                <td data-label="Bereich"><input type="text" class="eingabe-breit" name="name" form="bereich-edit-<%= b.id %>" value="<%= b.name %>" maxlength="100" required aria-label="Name"></td>
                <td data-label="Personen"><%= b.anzahl_personen %></td>
                <td data-label="Ausgleichsstunden"><%= zahl(b.stunden) %></td>
                <td data-label="Unterschrift">
                  <% if (b.dokument) { %><a href="/admin/dokumente/<%= b.dokument.id %>/datei" target="_blank" rel="noopener">vorhanden</a><% } else { %><span class="meta">fehlt</span><% } %>
                </td>
                <td data-label="Aktion">
                  <div class="entries-row-actions">
                    <button type="submit" form="bereich-edit-<%= b.id %>" class="link-button">Speichern</button>
                    <a href="/admin/bereiche/<%= b.id %>">Details</a>
                    <a href="/admin/druck/bereich/<%= b.id %>" target="_blank" rel="noopener">Drucken</a>
                    <% if (b.anzahl_zuweisungen === 0 && !b.dokument) { %>
                      <form method="post" action="/admin/bereiche/<%= b.id %>/delete" class="inline-form"
                            data-confirm="Bereich &quot;<%= b.name %>&quot; wirklich löschen?">
                        <%- include('../partials/csrf') %>
                        <button type="submit" class="link-button link-button-danger">Löschen</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } %>
    </section>
  </main>
  <script src="/public/js/forms.js"></script>
  <script src="/public/js/theme.js"></script>
  <script src="/public/js/pwa.js"></script>
</body>
</html>
