<!DOCTYPE html>
<html lang="de">
<head>
  <title>Admin – Zeiterfassung</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <h1>Lehrkräfte</h1>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

    <section class="panel">
      <h2>Faktor <span class="meta">Schuljahr <%= schuljahr %></span></h2>
      <p class="hint">
        Gilt einheitlich für alle Lehrkräfte in diesem Schuljahr: benötigte
        Zeitstunden = Ausgleichsstunden × Zeitstunden pro Woche × Schulwochen.
        Z. B. 1,7 Zeitstunden pro Woche × 40 Schulwochen = 68 Zeitstunden je
        Ausgleichsstunde und Schuljahr. Eine Änderung wirkt sich sofort auf
        alle bereits zugewiesenen Ausgleichsstunden dieses Schuljahres aus.
      </p>
      <form method="post" action="/admin/faktor" class="entry-form">
        <input type="number" step="0.1" min="0" name="zeitstunden" placeholder="Zeitstunden pro Woche" value="<%= faktorSettings ? faktorSettings.zeitstundenProWoche : '' %>" required>
        <input type="number" step="1" min="0" name="schulwochen" placeholder="Schulwochen" value="<%= faktorSettings ? faktorSettings.schulwochen : '' %>" required>
        <button type="submit" class="btn btn-start"><%= faktorSettings ? 'Aktualisieren' : 'Festlegen' %></button>
      </form>
      <% if (faktorSettings) { %>
        <p class="hint" style="margin-top: 12px; margin-bottom: 0;">
          = <%= faktorSettings.faktor.toFixed(2) %> Zeitstunden je Ausgleichsstunde und Schuljahr
        </p>
      <% } else { %>
        <p class="alert alert-error" style="margin-top: 12px;">
          Noch keine Werte für dieses Schuljahr festgelegt. Ohne diese Angabe
          können keine Ausgleichsstunden zugewiesen werden.
        </p>
      <% } %>
    </section>

    <section class="panel">
      <h2>Ausgleichsstunden zuweisen</h2>
      <p class="hint">
        Benutzernamen direkt eintippen oder aus der LDAP-Suche auswählen
        (falls verfügbar) und Ausgleichsstunden für das laufende Schuljahr
        zuweisen. Die Lehrkraft verknüpft die Zuweisung anschließend selbst
        mit einer eigenen Kategorie.
      </p>
      <form method="post" action="/admin/assign" id="assign-form" class="assign-form">
        <div class="autocomplete">
          <label for="assign-username">Benutzername</label>
          <input type="text" id="assign-username" name="username" placeholder="Benutzername eingeben oder aus Suche wählen…" autocomplete="off" required>
          <div id="ldap-results" class="autocomplete-results"></div>
        </div>
        <input type="hidden" name="displayName" id="assign-displayName">
        <input type="hidden" name="email" id="assign-email">
        <p id="assign-selected" class="selected-user"></p>
        <input type="number" step="0.25" min="0" name="ausgleichsstunden" placeholder="Ausgleichsstunden" required>
        <button type="submit" class="btn btn-start">Zuweisen</button>
      </form>
    </section>

    <section class="panel">
      <h2>Übersicht</h2>
      <table class="entries-table">
        <thead><tr><th>Name</th><th>Benutzername</th><th>Offene Zuweisungen</th><th></th></tr></thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.display_name %></td>
              <td><%= u.username %></td>
              <td><%= u.offene_zuweisungen %></td>
              <td><a href="/admin/users/<%= u.id %>">Details</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (users.length === 0) { %><p class="empty-state">Noch keine Lehrkräfte erfasst.</p><% } %>
    </section>
  </main>
  <script src="/public/js/admin.js"></script>
  <script src="/public/js/theme.js"></script>
</body>
</html>
