<!DOCTYPE html>
<html lang="de">
<head>
  <title>Admin – Zeiterfassung</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <%- include('../partials/admin-subnav', { aktiv: 'start', pfad: '/admin' }) %>

    <div class="page-header">
      <h1>Admin <span class="meta">Schuljahr <%= schuljahr %></span></h1>
      <a href="/admin/zuweisen?schuljahr=<%= encodeURIComponent(schuljahr) %>" class="btn btn-start">Ausgleichsstunden zuweisen</a>
    </div>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

    <% if (!faktorSettings) { %>
      <p class="alert alert-error">
        Für <%= schuljahr %> ist noch kein Faktor festgelegt – ohne ihn lassen sich keine
        Ausgleichsstunden zuweisen.
        <a href="/admin/faktor?schuljahr=<%= encodeURIComponent(schuljahr) %>">Faktor festlegen</a>
      </p>
    <% } %>

    <section class="panel">
      <h2>Gesamtpool</h2>
      <% if (gesamt.anzahl === 0) { %>
        <p class="empty-state">Für <%= schuljahr %> gibt es noch keinen Pool.</p>
        <a href="/admin/pools?schuljahr=<%= encodeURIComponent(schuljahr) %>" class="btn">Pools anlegen</a>
      <% } else { %>
        <div class="stat-grid">
          <div class="stat"><span class="stat-wert"><%= zahl(gesamt.stunden) %> h</span><span class="stat-label">im Gesamtpool</span></div>
          <div class="stat"><span class="stat-wert"><%= zahl(gesamt.vergeben) %> h</span><span class="stat-label">vergeben</span></div>
          <div class="stat"><span class="stat-wert"><%= zahl(gesamt.frei) %> h</span><span class="stat-label">noch frei</span></div>
        </div>
        <div class="progress" role="img" aria-label="<%= zahl(gesamt.vergeben) %> von <%= zahl(gesamt.stunden) %> Stunden vergeben">
          <div class="progress-bar" style="width: <%= gesamt.stunden > 0 ? Math.min(100, (gesamt.vergeben / gesamt.stunden) * 100) : 0 %>%"></div>
        </div>

        <ul class="pool-liste">
          <% pools.forEach(p => { %>
            <li>
              <a href="/admin/pools/<%= p.id %>" class="pool-zeile">
                <span class="pool-name"><%= p.name %></span>
                <span class="pool-zahlen"><%= zahl(p.vergeben) %> von <%= zahl(p.stunden) %> h</span>
              </a>
              <div class="progress progress-klein"><div class="progress-bar" style="width: <%= p.stunden > 0 ? Math.min(100, (p.vergeben / p.stunden) * 100) : 0 %>%"></div></div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <div class="kachel-grid">
      <a class="kachel" href="/admin/lehrkraefte?schuljahr=<%= encodeURIComponent(schuljahr) %>">
        <span class="kachel-titel">Lehrkräfte</span>
        <span class="kachel-wert"><%= anzahlLehrkraefte %></span>
        <span class="kachel-text">mit Ausgleichsstunden<% if (offeneZuweisungen > 0) { %> · <%= offeneZuweisungen %> noch nicht verknüpft<% } %></span>
      </a>
      <a class="kachel" href="/admin/bereiche?schuljahr=<%= encodeURIComponent(schuljahr) %>">
        <span class="kachel-titel">Bereiche</span>
        <span class="kachel-wert"><%= anzahlBereiche %></span>
        <span class="kachel-text">in diesem Schuljahr</span>
      </a>
      <a class="kachel" href="/admin/uebersicht?schuljahr=<%= encodeURIComponent(schuljahr) %>">
        <span class="kachel-titel">Übersicht &amp; Druck</span>
        <span class="kachel-wert">PDF</span>
        <span class="kachel-text">Tabellen, Ausdruck zum Unterschreiben</span>
      </a>
      <a class="kachel" href="/admin/dokumente?schuljahr=<%= encodeURIComponent(schuljahr) %>">
        <span class="kachel-titel">Unterschriebene Dokumente</span>
        <span class="kachel-wert"><%= dokumente.vorhanden %> von <%= dokumente.noetig %></span>
        <span class="kachel-text">hochgeladen</span>
      </a>
      <a class="kachel" href="/admin/faktor?schuljahr=<%= encodeURIComponent(schuljahr) %>">
        <span class="kachel-titel">Faktor</span>
        <span class="kachel-wert"><%= faktorSettings ? zahl(faktorSettings.faktor) + ' h' : '–' %></span>
        <span class="kachel-text">Zeitstunden je Ausgleichsstunde</span>
      </a>
      <a class="kachel" href="/admin/pools?schuljahr=<%= encodeURIComponent(naechstesSchuljahr) %>&amp;uebernehmen=1#uebernehmen">
        <span class="kachel-titel">Nächstes Schuljahr</span>
        <span class="kachel-wert"><%= naechstesSchuljahr %></span>
        <span class="kachel-text">vorbereiten: Pools, Bereiche, Zuweisungen übernehmen</span>
      </a>
    </div>
  </main>
  <script src="/public/js/forms.js"></script>
  <script src="/public/js/theme.js"></script>
  <script src="/public/js/pwa.js"></script>
</body>
</html>
