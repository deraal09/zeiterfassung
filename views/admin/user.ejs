<!DOCTYPE html>
<html lang="de">
<head>
  <title><%= teacher.display_name %> – Admin</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <p><a href="/admin">&larr; Zur Übersicht</a></p>
    <h1><%= teacher.display_name %></h1>
    <p class="meta"><%= teacher.username %><% if (teacher.email) { %> · <%= teacher.email %><% } %></p>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

    <section class="panel">
      <h2>Ausgleichsstunden zuweisen <span class="meta">Schuljahr <%= aktuellesSchuljahr %></span></h2>
      <form method="post" action="/admin/users/<%= teacher.id %>/zuweisungen" class="entry-form">
        <input type="number" step="0.25" min="0" name="ausgleichsstunden" placeholder="Ausgleichsstunden" required>
        <% const aktiveKategorien = categories.filter(c => !c.archived); %>
        <% if (aktiveKategorien.length > 0) { %>
          <select name="category_id">
            <option value="">Kategorie noch offen lassen (optional)</option>
            <% aktiveKategorien.forEach(cat => { %>
              <option value="<%= cat.id %>"><%= cat.title %></option>
            <% }) %>
          </select>
          <p class="hint" style="width: 100%; margin: 0;">
            Bei direkter Auswahl muss die Verknüpfung noch von der Lehrkraft bestätigt werden.
          </p>
        <% } %>
        <button type="submit" class="btn btn-start">Zuweisen</button>
      </form>
    </section>

    <section class="panel">
      <h2>Zuweisungen</h2>
      <p class="hint">
        Eine Verknüpfung mit einer Kategorie ist nur ein Vorschlag, bis die
        Lehrkraft ihn annimmt. Solange dafür noch keine Zeiten erfasst
        wurden, lässt sich die Verknüpfung noch per neuem Vorschlag ändern.
      </p>
      <table class="entries-table">
        <thead><tr><th>Schuljahr</th><th>Ausgleichsstunden</th><th>Faktor</th><th>Zeitstunden</th><th>Kategorie</th><th></th></tr></thead>
        <tbody>
          <% zuweisungen.forEach(z => { %>
            <tr>
              <td><%= z.schuljahr %></td>
              <td>
                <form method="post" action="/admin/zuweisungen/<%= z.id %>/edit" class="inline-form">
                  <input type="number" step="0.25" min="0.25" name="ausgleichsstunden" value="<%= z.ausgleichsstunden %>" style="width: 80px;">
                  <button type="submit" class="link-button">Speichern</button>
                </form>
              </td>
              <td><%= z.faktor %></td>
              <td><%= (z.ausgleichsstunden * z.faktor).toFixed(2) %> h</td>
              <td>
                <% if (z.category_title) { %>
                  <strong><%= z.category_title %></strong>
                  <% if (z.gesperrt) { %><p class="hint" style="margin: 4px 0 0;">fest, da bereits Zeiten erfasst</p><% } %>
                <% } else { %>
                  <span class="meta">noch nicht verknüpft</span>
                <% } %>

                <% if (z.vorschlag_von === 'lehrkraft') { %>
                  <p class="hint" style="margin: 6px 0 4px;">
                    Vorschlag der Lehrkraft: <strong><%= z.vorschlag_category_title || '– Verknüpfung aufheben –' %></strong>
                  </p>
                  <div class="zuweisung-actions">
                    <form method="post" action="/admin/zuweisungen/<%= z.id %>/annehmen" class="inline-form">
                      <button type="submit" class="link-button">Annehmen</button>
                    </form>
                    <form method="post" action="/admin/zuweisungen/<%= z.id %>/ablehnen" class="inline-form">
                      <button type="submit" class="link-button link-button-danger">Ablehnen</button>
                    </form>
                  </div>
                <% } else if (z.vorschlag_von === 'admin') { %>
                  <p class="hint" style="margin: 6px 0 0;">
                    Dein Vorschlag (<%= z.vorschlag_category_title || '– Verknüpfung aufheben –' %>) wartet auf Bestätigung durch die Lehrkraft.
                  </p>
                <% } else if (!z.gesperrt && categories.filter(c => !c.archived).length > 0) { %>
                  <form method="post" action="/admin/zuweisungen/<%= z.id %>/link" class="inline-form" style="margin-top: 6px;">
                    <select name="category_id">
                      <option value="">– keine Verknüpfung –</option>
                      <% categories.filter(c => !c.archived).forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= z.category_id === cat.id ? 'selected' : '' %>><%= cat.title %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="link-button"><%= z.category_title ? 'Änderung vorschlagen' : 'Vorschlagen' %></button>
                  </form>
                <% } %>
              </td>
              <td>
                <% if (z.gesperrt) { %>
                  <p class="hint" style="margin: 0;">
                    Nicht mehr löschbar (Zeiten erfasst). Um die Zuweisung
                    trotzdem zu entfernen, muss die Lehrkraft die Zeiten auf
                    eine andere Kategorie übertragen oder die Verknüpfung
                    lösen.
                  </p>
                <% } else { %>
                  <form method="post" action="/admin/zuweisungen/<%= z.id %>/delete" class="inline-form" onsubmit="return confirm('Diese Zuweisung wirklich entfernen?');">
                    <button type="submit" class="link-button link-button-danger">Löschen</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (zuweisungen.length === 0) { %><p class="empty-state">Noch keine Ausgleichsstunden zugewiesen.</p><% } %>
    </section>

    <section class="panel">
      <h2>Kategorien</h2>
      <table class="entries-table">
        <thead>
          <tr>
            <th>Titel</th><th>Schuljahr</th><th>Benötigt</th>
            <th>Synchronisiert</th><th>Offen (ungemeldet)</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(cat => { %>
            <tr class="<%= cat.archived ? 'archived' : '' %>">
              <td><%= cat.title %></td>
              <td><%= cat.schuljahr %></td>
              <td><%= cat.requiredHours.toFixed(2) %> h</td>
              <td><%= cat.syncedHours.toFixed(2) %> h</td>
              <td><%= cat.unsyncedHours.toFixed(2) %> h</td>
              <td>
                <form method="post" action="/admin/categories/<%= cat.id %>/archive" class="inline-form">
                  <button type="submit" class="link-button"><%= cat.archived ? 'Reaktivieren' : 'Archivieren' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (categories.length === 0) { %><p class="empty-state">Diese Lehrkraft hat noch keine (für dich sichtbare) Kategorie angelegt.</p><% } %>
      <% if (hiddenCategoryCount > 0) { %>
        <p class="hint" style="margin-top: 12px; margin-bottom: 0;">
          <%= hiddenCategoryCount %> weitere private Kategorie<%= hiddenCategoryCount === 1 ? '' : 'n' %> dieser Lehrkraft
          <%= hiddenCategoryCount === 1 ? 'ist' : 'sind' %> noch nicht freigegeben oder mit einer Zuweisung verknüpft.
        </p>
      <% } %>
    </section>
  </main>
  <script src="/public/js/theme.js"></script>
</body>
</html>
