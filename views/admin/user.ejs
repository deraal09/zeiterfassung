<!DOCTYPE html>
<html lang="de">
<head>
  <title><%= teacher.display_name %> – Admin</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <%- include('../partials/admin-subnav', { aktiv: 'lehrkraefte', pfad: `/admin/users/${teacher.id}` }) %>
    <p><a href="/admin/lehrkraefte?schuljahr=<%= encodeURIComponent(schuljahr) %>">&larr; Alle Lehrkräfte</a></p>
    <h1><%= teacher.display_name %></h1>
    <p class="meta"><%= teacher.username %><% if (teacher.email) { %> · <%= teacher.email %><% } %></p>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

    <% if (kontoEntfernbar) { %>
      <p class="hint">
        Dieses Konto hat weder Zuweisungen noch Aufgabenbereiche oder Zeiten und war
        nie angemeldet – vermutlich ein Vertipper beim Benutzernamen.
        <form method="post" action="/admin/users/<%= teacher.id %>/delete" class="inline-form"
              data-confirm="Konto &quot;<%= teacher.username %>&quot; wirklich entfernen?">
          <%- include('../partials/csrf') %>
          <button type="submit" class="link-button link-button-danger">Konto entfernen</button>
        </form>
      </p>
    <% } %>

    <section class="panel">
      <h2>Ausgleichsstunden zuweisen <span class="meta">Schuljahr <%= schuljahr %></span></h2>
      <% if (pools.length === 0) { %>
        <p class="empty-state">Für <%= schuljahr %> gibt es noch keinen Pool – jede Ausgleichsstunde muss aus einem Pool vergeben werden.</p>
        <a href="/admin/pools?schuljahr=<%= encodeURIComponent(schuljahr) %>" class="btn">Pool anlegen</a>
      <% } else { %>
        <form method="post" action="/admin/users/<%= teacher.id %>/zuweisungen" class="assign-form">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="schuljahr" value="<%= schuljahr %>">
          <label for="neu-stunden">Ausgleichsstunden</label>
          <input type="number" id="neu-stunden" step="0.25" min="0.25" name="ausgleichsstunden" data-pool-stunden="neu" required>

          <label>Pool</label>
          <%- include('../partials/pool-auswahl', { pools, gruppe: 'neu' }) %>

          <label for="neu-bereich">Bereich <span class="meta">(optional)</span></label>
          <select id="neu-bereich" name="bereich_id">
            <option value="">– kein Bereich –</option>
            <% bereiche.forEach(b => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
          </select>

          <% const aktiveKategorien = categories.filter(c => !c.archived && c.schuljahr === schuljahr); %>
          <% if (aktiveKategorien.length > 0) { %>
            <label for="neu-aufgabenbereich">Aufgabenbereich der Lehrkraft <span class="meta">(optional)</span></label>
            <select id="neu-aufgabenbereich" name="category_id">
              <option value="">Aufgabenbereich noch offen lassen</option>
              <% aktiveKategorien.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.title %></option>
              <% }) %>
            </select>
            <p class="hint">Bei direkter Auswahl muss die Verknüpfung noch von der Lehrkraft bestätigt werden.</p>
          <% } %>
          <button type="submit" class="btn btn-start">Zuweisen</button>
        </form>
      <% } %>
    </section>

    <section class="panel">
      <h2>Zuweisungen</h2>
      <p class="hint">
        Pool und Bereich lassen sich hier ändern; der Pool darf dabei nie mehr vergeben,
        als er enthält. Eine Verknüpfung mit einem Aufgabenbereich ist nur ein Vorschlag,
        bis die Lehrkraft ihn annimmt. Solange dafür noch keine Zeiten erfasst wurden,
        lässt sich die Verknüpfung noch per neuem Vorschlag ändern.
      </p>

      <% zuweisungen.forEach(z => { %>
        <article class="zuweisung-item">
          <p class="zuweisung-meta">
            <strong>Schuljahr <%= z.schuljahr %></strong>
            <% if (z.faktor) { %>
              · <%= zahl(z.ausgleichsstunden * z.faktor) %> Zeitstunden <span class="meta">(Faktor <%= zahl(z.faktor) %>)</span>
            <% } else { %>
              · <span class="meta" title="Für dieses Schuljahr sind Zeitstunden pro Woche und Schulwochen noch nicht festgelegt.">Faktor fehlt</span>
            <% } %>
          </p>

          <form id="zuw-edit-<%= z.id %>" method="post" action="/admin/zuweisungen/<%= z.id %>/edit">
            <%- include('../partials/csrf') %>
          </form>
          <div class="zuweisung-felder">
            <div>
              <label for="zuw-<%= z.id %>-stunden">Ausgleichsstunden</label>
              <input type="number" id="zuw-<%= z.id %>-stunden" step="0.25" min="0.25" name="ausgleichsstunden" form="zuw-edit-<%= z.id %>"
                     value="<%= z.ausgleichsstunden %>" data-pool-stunden="z<%= z.id %>" required>
            </div>
            <div class="zuweisung-pool">
              <label>Pool</label>
              <%- include('../partials/pool-auswahl', { pools: z.poolOptionen, gewaehlt: z.pool_id, gruppe: `z${z.id}`, formId: `zuw-edit-${z.id}` }) %>
            </div>
            <div>
              <label for="zuw-<%= z.id %>-bereich">Bereich</label>
              <select id="zuw-<%= z.id %>-bereich" name="bereich_id" form="zuw-edit-<%= z.id %>">
                <option value="">– kein Bereich –</option>
                <% z.bereichOptionen.forEach(b => { %>
                  <option value="<%= b.id %>" <%= z.bereich_id === b.id ? 'selected' : '' %>><%= b.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="zuweisung-speichern">
              <button type="submit" form="zuw-edit-<%= z.id %>" class="btn">Speichern</button>
            </div>
          </div>

          <div class="zuweisung-verknuepfung">
            <h3>Aufgabenbereich</h3>
            <% if (z.category_title) { %>
              <strong><%= z.category_title %></strong>
              <% if (z.gesperrt) { %><p class="hint" style="margin: 4px 0 0;">Änderung nur noch durch die Lehrkraft (Lösen), da bereits Zeiten erfasst</p><% } %>
            <% } else { %>
              <span class="meta">noch nicht verknüpft</span>
              <% if (z.geloest_am) { %>
                <p class="hint" style="margin: 4px 0 0;">Von der Lehrkraft am <%= z.geloest_am.slice(0, 10) %> gelöst.</p>
              <% } %>
            <% } %>

            <% if (z.vorschlag_von === 'lehrkraft') { %>
              <p class="hint" style="margin: 6px 0 4px;">
                Vorschlag der Lehrkraft: <strong><%= z.vorschlag_category_title || '– Verknüpfung aufheben –' %></strong>
              </p>
              <div class="zuweisung-actions">
                <form method="post" action="/admin/zuweisungen/<%= z.id %>/annehmen" class="inline-form">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="link-button">Annehmen</button>
                </form>
                <form method="post" action="/admin/zuweisungen/<%= z.id %>/ablehnen" class="inline-form">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="link-button link-button-danger">Ablehnen</button>
                </form>
              </div>
            <% } else if (z.vorschlag_von === 'admin') { %>
              <p class="hint" style="margin: 6px 0 0;">
                Dein Vorschlag (<%= z.vorschlag_category_title || '– Verknüpfung aufheben –' %>) wartet auf Bestätigung durch die Lehrkraft.
              </p>
            <% } else if (!z.gesperrt) { %>
              <%# Nur Aufgabenbereiche aus dem Schuljahr DIESER Zuweisung: der %>
              <%# Faktor haengt am Schuljahr der Zuweisung, das Ziel am %>
              <%# Aufgabenbereich - jahresuebergreifend passt beides nicht zusammen. %>
              <% const passende = categories.filter(c => !c.archived && c.schuljahr === z.schuljahr); %>
              <% if (passende.length > 0) { %>
                <form method="post" action="/admin/zuweisungen/<%= z.id %>/link" class="inline-form" style="margin-top: 6px;">
                  <%- include('../partials/csrf') %>
                  <select name="category_id" aria-label="Aufgabenbereich">
                    <option value="">– keine Verknüpfung –</option>
                    <% passende.forEach(cat => { %>
                      <option value="<%= cat.id %>" <%= z.category_id === cat.id ? 'selected' : '' %>><%= cat.title %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="link-button"><%= z.category_title ? 'Änderung vorschlagen' : 'Vorschlagen' %></button>
                </form>
              <% } else { %>
                <p class="hint" style="margin: 6px 0 0;">
                  Kein Aufgabenbereich dieser Lehrkraft für <%= z.schuljahr %> vorhanden.
                </p>
              <% } %>
            <% } %>
          </div>

          <div class="zuweisung-loeschen">
            <% if (z.gesperrt) { %>
              <p class="hint" style="margin: 0;">
                Nicht mehr löschbar (Zeiten erfasst). Um die Zuweisung
                trotzdem zu entfernen, muss die Lehrkraft die Verknüpfung
                lösen (die erfassten Zeiten bleiben dabei erhalten).
              </p>
            <% } else { %>
              <form method="post" action="/admin/zuweisungen/<%= z.id %>/delete" class="inline-form" data-confirm="Diese Zuweisung wirklich entfernen?">
                <%- include('../partials/csrf') %>
                <button type="submit" class="link-button link-button-danger">Zuweisung löschen</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
      <% if (zuweisungen.length === 0) { %><p class="empty-state">Noch keine Ausgleichsstunden zugewiesen.</p><% } %>
    </section>

    <section class="panel">
      <h2>Aufgabenbereiche</h2>
      <div class="table-scroll">
      <table class="entries-table">
        <thead>
          <tr>
            <th>Titel</th><th>Schuljahr</th><th>Benötigt</th>
            <th>Synchronisiert</th><th>Offen (ungemeldet)</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(cat => { %>
            <tr class="<%= cat.archived ? 'archived' : '' %>">
              <td data-label="Titel"><%= cat.title %></td>
              <td data-label="Schuljahr"><%= cat.schuljahr %></td>
              <td data-label="Benötigt">
                <% if (cat.ziel.stunden !== null) { %>
                  <%= cat.ziel.stunden.toFixed(2) %> h
                <% } else { %>
                  <span class="meta"><%= cat.ziel.quelle === 'kein-faktor' ? 'Faktor fehlt' : '–' %></span>
                <% } %>
              </td>
              <td data-label="Synchronisiert"><%= cat.syncedHours.toFixed(2) %> h</td>
              <td data-label="Offen (ungemeldet)"><%= cat.unsyncedHours.toFixed(2) %> h</td>
              <td data-label="Aktion">
                <form method="post" action="/admin/categories/<%= cat.id %>/archive" class="inline-form">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="link-button"><%= cat.archived ? 'Reaktivieren' : 'Archivieren' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% if (categories.length === 0) { %><p class="empty-state">Diese Lehrkraft hat noch keinen (für dich sichtbaren) Aufgabenbereich angelegt.</p><% } %>
      <% if (hiddenCategoryCount > 0) { %>
        <p class="hint" style="margin-top: 12px; margin-bottom: 0;">
          <%= hiddenCategoryCount %> weitere<%= hiddenCategoryCount === 1 ? 'r' : '' %> private<%= hiddenCategoryCount === 1 ? 'r' : '' %> Aufgabenbereich<%= hiddenCategoryCount === 1 ? '' : 'e' %> dieser Lehrkraft
          <%= hiddenCategoryCount === 1 ? 'ist' : 'sind' %> noch nicht freigegeben oder mit einer Zuweisung verknüpft.
        </p>
      <% } %>
    </section>
  </main>
  <script src="/public/js/pool-auswahl.js?v=<%= assetVersion %>"></script>
  <script src="/public/js/theme.js?v=<%= assetVersion %>"></script>
  <script src="/public/js/forms.js?v=<%= assetVersion %>"></script>
  <script src="/public/js/pwa.js?v=<%= assetVersion %>"></script>
</body>
</html>
