<!DOCTYPE html>
<html lang="de">
<head>
  <title><%= category.title %> – Zeiterfassung</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <p><a href="/">&larr; Zur Übersicht</a></p>
    <h1><%= category.title %> <span class="meta">Schuljahr <%= category.schuljahr %></span></h1>
    <p class="meta">Benötigt: <%= benoetigteStunden.toFixed(2) %> Zeitstunden</p>
    <div class="progress">
      <div class="progress-bar" style="width: <%= Math.min(100, (erfassteStunden / benoetigteStunden) * 100 || 0) %>%"></div>
    </div>
    <p class="progress-label"><%= erfassteStunden.toFixed(2) %> von <%= benoetigteStunden.toFixed(2) %> Zeitstunden erfasst</p>

    <form method="post" action="/categories/<%= category.id %>/sichtbarkeit" class="inline-form">
      <label class="checkbox">
        <input type="checkbox" name="sichtbar" onchange="this.form.submit()" <%= category.visible_for_admin || hatZuweisung ? 'checked' : '' %> <%= hatZuweisung ? 'disabled' : '' %>>
        Für Admin sichtbar machen
      </label>
    </form>
    <% if (hatZuweisung) { %>
      <p class="hint" style="margin-top: 4px;">
        Diese Kategorie ist bereits mit zugewiesenen Ausgleichsstunden verknüpft und dadurch automatisch für den Admin sichtbar.
      </p>
    <% } %>

    <% if (!hatZuweisung) { %>
      <form method="post" action="/categories/<%= category.id %>/ziel" class="inline-form" style="margin-top: 8px;">
        <label for="ziel_zeitstunden" class="hint" style="margin: 0;">Eigenes Ziel (Zeitstunden):</label>
        <input type="number" id="ziel_zeitstunden" name="ziel_zeitstunden" step="0.25" min="0.25" value="<%= category.ziel_zeitstunden || '' %>" placeholder="z. B. 10">
        <button type="submit" class="btn">Speichern</button>
      </form>
      <p class="hint" style="margin-top: 4px;">
        Gilt nur, solange keine Ausgleichsstunden-Zuweisung verknüpft ist. Danach zählt die offizielle Berechnung.
      </p>
    <% } else if (category.ziel_zeitstunden) { %>
      <p class="hint" style="margin-top: 4px;">
        Eigenes Ziel war <%= category.ziel_zeitstunden %> Zeitstunden (nicht mehr änderbar, da bereits verknüpft).
      </p>
    <% } %>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <% if (importInfo) { %>
      <p class="alert alert-success">
        CSV-Import: <%= importInfo.importiert %> <%= importInfo.importiert === 1 ? 'Eintrag' : 'Einträge' %> übernommen<% if (importInfo.uebersprungen > 0) { %>, <%= importInfo.uebersprungen %> <%= importInfo.uebersprungen === 1 ? 'Zeile' : 'Zeilen' %> übersprungen (ungültiges Datum/Uhrzeit oder Bis vor Von)<% } %>.
      </p>
    <% } %>

    <div class="tabs" data-tabs>
      <div class="tab-buttons" role="tablist">
        <button type="button" class="tab-button<%= activeTab === 'erfassen' ? ' active' : '' %>" data-tab-target="tab-erfassen">Erfassen</button>
        <button type="button" class="tab-button<%= activeTab === 'nachtragen' ? ' active' : '' %>" data-tab-target="tab-nachtragen">Zeit nachtragen</button>
        <button type="button" class="tab-button<%= activeTab === 'import' ? ' active' : '' %>" data-tab-target="tab-import">CSV-Import</button>
      </div>

      <section class="panel tab-panel" id="tab-erfassen" data-tab-panel <%= activeTab === 'erfassen' ? '' : 'hidden' %>>
        <% if (running) { %>
          <div class="timer-banner">
            <div>
              <strong>Läuft:</strong> <%= running.beschreibung %>
              <span class="live-timer" data-start="<%= running.start_time %>">00:00:00</span>
            </div>
            <form method="post" action="/entries/<%= running.id %>/stop">
              <button type="submit" class="btn btn-stop">Stopp</button>
            </form>
          </div>
        <% } else { %>
          <form method="post" action="/categories/<%= category.id %>/start" class="inline-form">
            <input type="text" name="beschreibung" placeholder="Kurze Tätigkeitsbeschreibung" required>
            <button type="submit" class="btn btn-start">Start</button>
          </form>
        <% } %>
      </section>

      <section class="panel tab-panel" id="tab-nachtragen" data-tab-panel <%= activeTab === 'nachtragen' ? '' : 'hidden' %>>
        <h2>Zeit nachtragen</h2>
        <form method="post" action="/categories/<%= category.id %>/entries" class="entry-form">
          <input type="text" name="beschreibung" placeholder="Tätigkeitsbeschreibung" required>
          <input type="date" name="datum" required>
          <input type="time" name="von" required>
          <input type="time" name="bis" required>
          <button type="submit" class="btn">Eintragen</button>
        </form>
      </section>

      <section class="panel tab-panel" id="tab-import" data-tab-panel <%= activeTab === 'import' ? '' : 'hidden' %>>
        <h2>Zeiten per CSV importieren</h2>
        <p class="hint">
          Spalten (Kopfzeile erforderlich): <code>Datum</code>, <code>Von</code>,
          <code>Bis</code>, <code>Beschreibung</code>. Datum als
          <code>YYYY-MM-DD</code> oder <code>DD.MM.YYYY</code>, Uhrzeiten als
          <code>HH:MM</code>. Komma, Semikolon, Tabulator und Pipe (<code>|</code>)
          werden automatisch als Trennzeichen erkannt.
        </p>
        <form method="post" action="/categories/<%= category.id %>/import" enctype="multipart/form-data" class="inline-form">
          <input type="file" name="csv_file" accept=".csv,text/csv" required>
          <button type="submit" class="btn">Importieren</button>
        </form>
      </section>
    </div>

    <section class="panel">
      <h2>Erfasste Tätigkeiten</h2>
      <p class="hint">Falls sich jemand verschrieben hat: Werte anpassen und "Speichern" klicken.</p>

      <form method="get" action="/categories/<%= category.id %>" class="entry-form">
        <input type="date" name="von" value="<%= filter.von %>" title="Von Datum">
        <input type="date" name="bis" value="<%= filter.bis %>" title="Bis Datum">
        <input type="text" name="suche" value="<%= filter.suche %>" placeholder="Beschreibung durchsuchen">
        <input type="hidden" name="sort" value="<%= filter.sort %>">
        <button type="submit" class="btn">Filtern</button>
        <% if (filter.von || filter.bis || filter.suche) { %>
          <a class="btn" href="/categories/<%= category.id %>?sort=<%= filter.sort %>">Zurücksetzen</a>
        <% } %>
      </form>

      <% entries.forEach(e => { %>
        <form id="entry-edit-<%= e.id %>" method="post" action="/entries/<%= e.id %>/edit"></form>
      <% }) %>
      <table class="entries-table">
        <thead>
          <tr>
            <th>
              <a href="/categories/<%= category.id %>?sort=<%= filter.sort === 'asc' ? 'desc' : 'asc' %>&von=<%= encodeURIComponent(filter.von) %>&bis=<%= encodeURIComponent(filter.bis) %>&suche=<%= encodeURIComponent(filter.suche) %>">
                Datum <%= filter.sort === 'asc' ? '▲' : '▼' %>
              </a>
            </th>
            <th>Von</th><th>Bis</th><th>Dauer</th><th>Beschreibung</th><th>Status</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% entries.forEach(e => { %>
            <tr>
              <td><input type="date" name="datum" form="entry-edit-<%= e.id %>" value="<%= e.start_time.slice(0,10) %>" required></td>
              <td><input type="time" name="von" form="entry-edit-<%= e.id %>" value="<%= e.start_time.slice(11,16) %>" required></td>
              <td><input type="time" name="bis" form="entry-edit-<%= e.id %>" value="<%= e.end_time.slice(11,16) %>" required></td>
              <td><%= (e.duration_minutes/60).toFixed(2) %> h</td>
              <td><input type="text" name="beschreibung" form="entry-edit-<%= e.id %>" value="<%= e.beschreibung %>" required></td>
              <td><%= e.synced ? 'Synchronisiert' : 'Entwurf' %></td>
              <td class="entries-row-actions">
                <button type="submit" form="entry-edit-<%= e.id %>" class="link-button">Speichern</button>
                <form method="post" action="/entries/<%= e.id %>/delete" class="inline-form">
                  <button type="submit" class="link-button link-button-danger">Löschen</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (entries.length === 0) { %>
        <p class="empty-state">
          <%= (filter.von || filter.bis || filter.suche) ? 'Keine Tätigkeiten für diesen Filter gefunden.' : 'Noch keine Tätigkeiten erfasst.' %>
        </p>
      <% } %>
    </section>
  </main>
  <script src="/public/js/timer.js"></script>
  <script src="/public/js/theme.js"></script>
  <script src="/public/js/tabs.js"></script>
</body>
</html>
