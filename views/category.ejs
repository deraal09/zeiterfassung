<!DOCTYPE html>
<html lang="de">
<head>
  <title><%= category.title %> – Zeiterfassung</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <p><a href="/">&larr; Zur Übersicht</a></p>
    <h1><%= category.title %> <span class="meta">Schuljahr <%= category.schuljahr %></span></h1>
    <% if (ziel.stunden !== null) { %>
      <p class="meta">Benötigt: <%= ziel.stunden.toFixed(2) %> Zeitstunden</p>
      <div class="progress">
        <div class="progress-bar" style="width: <%= fortschritt %>%"></div>
      </div>
      <p class="progress-label"><%= erfassteStunden.toFixed(2) %> von <%= ziel.stunden.toFixed(2) %> Zeitstunden erfasst</p>
    <% } else { %>
      <p class="progress-label"><%= erfassteStunden.toFixed(2) %> Zeitstunden erfasst</p>
      <p class="hint">
        <% if (ziel.quelle === 'kein-faktor') { %>
          Das Ziel steht noch nicht fest: Für das Schuljahr dieser Zuweisung hat die Schulleitung
          Zeitstunden pro Woche und Schulwochen noch nicht festgelegt.
        <% } else { %>
          Für diese Kategorie ist noch kein Ziel hinterlegt.
        <% } %>
      </p>
    <% } %>

    <form method="post" action="/categories/<%= category.id %>/sichtbarkeit" class="inline-form">
      <%- include('partials/csrf') %>
      <label class="checkbox">
        <input type="checkbox" name="sichtbar" data-submit-on-change <%= category.visible_for_admin || hatZuweisung ? 'checked' : '' %> <%= hatZuweisung ? 'disabled' : '' %>>
        Für Admin sichtbar machen
      </label>
    </form>
    <% if (hatZuweisung) { %>
      <p class="hint" style="margin-top: 4px;">
        Diese Kategorie ist bereits mit zugewiesenen Ausgleichsstunden verknüpft und dadurch automatisch für den Admin sichtbar.
      </p>
    <% } %>

    <% if (!hatZuweisung) { %>
      <form method="post" action="/categories/<%= category.id %>/ziel" class="inline-form" style="margin-top: 8px;">
        <%- include('partials/csrf') %>
        <label for="ziel_zeitstunden" class="hint" style="margin: 0;">Eigenes Ziel (Zeitstunden):</label>
        <input type="number" id="ziel_zeitstunden" name="ziel_zeitstunden" step="0.25" min="0.25" value="<%= category.ziel_zeitstunden || '' %>" placeholder="z. B. 10">
        <button type="submit" class="btn">Speichern</button>
      </form>
      <p class="hint" style="margin-top: 4px;">
        Gilt nur, solange keine Ausgleichsstunden-Zuweisung verknüpft ist. Danach zählt die offizielle Berechnung.
      </p>
    <% } else if (category.ziel_zeitstunden) { %>
      <p class="hint" style="margin-top: 4px;">
        Eigenes Ziel war <%= category.ziel_zeitstunden %> Zeitstunden (nicht mehr änderbar, da bereits verknüpft).
      </p>
    <% } %>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <% if (importInfo) { %>
      <p class="alert alert-success">
        CSV-Import: <%= importInfo.importiert %> <%= importInfo.importiert === 1 ? 'Eintrag' : 'Einträge' %> übernommen<% if (importInfo.uebersprungen > 0) { %>, <%= importInfo.uebersprungen %> <%= importInfo.uebersprungen === 1 ? 'Zeile' : 'Zeilen' %> übersprungen (ungültiges Datum/Uhrzeit oder Bis vor Von)<% } %>.
      </p>
    <% } %>

    <div class="tabs" data-tabs>
      <div class="tab-buttons" role="tablist">
        <button type="button" class="tab-button<%= activeTab === 'erfassen' ? ' active' : '' %>" data-tab-target="tab-erfassen">Erfassen</button>
        <button type="button" class="tab-button<%= activeTab === 'nachtragen' ? ' active' : '' %>" data-tab-target="tab-nachtragen">Zeit nachtragen</button>
        <button type="button" class="tab-button<%= activeTab === 'import' ? ' active' : '' %>" data-tab-target="tab-import">Import / Export</button>
        <button type="button" class="tab-button<%= activeTab === 'unterprojekte' ? ' active' : '' %>" data-tab-target="tab-unterprojekte">Unterprojekte</button>
      </div>

      <section class="panel tab-panel" id="tab-erfassen" data-tab-panel <%= activeTab === 'erfassen' ? '' : 'hidden' %>>
        <% if (running) { %>
          <div class="timer-banner">
            <div>
              <strong>Läuft:</strong> <%= running.beschreibung %><% if (running.unterprojekt_title) { %> <span class="meta">(<%= running.unterprojekt_title %>)</span><% } %>
              <span class="live-timer" data-start="<%= running.start_time %>">00:00:00</span>
            </div>
            <form method="post" action="/entries/<%= running.id %>/stop">
              <%- include('partials/csrf') %>
              <button type="submit" class="btn btn-stop">Stopp</button>
            </form>
          </div>
        <% } else { %>
          <form method="post" action="/categories/<%= category.id %>/start" class="inline-form">
            <%- include('partials/csrf') %>
            <input type="text" name="beschreibung" placeholder="Kurze Tätigkeitsbeschreibung" required>
            <% if (unterprojekte.length > 0) { %>
              <select name="unterprojekt_id" title="Unterprojekt (optional, sonst Allgemein)">
                <option value="">– Allgemein –</option>
                <% unterprojekte.forEach(up => { %>
                  <option value="<%= up.id %>"><%= up.title %></option>
                <% }) %>
              </select>
            <% } %>
            <button type="submit" class="btn btn-start">Start</button>
          </form>
        <% } %>
      </section>

      <section class="panel tab-panel" id="tab-nachtragen" data-tab-panel <%= activeTab === 'nachtragen' ? '' : 'hidden' %>>
        <h2>Zeit nachtragen</h2>
        <form method="post" action="/categories/<%= category.id %>/entries" class="entry-form">
          <%- include('partials/csrf') %>
          <input type="text" name="beschreibung" placeholder="Tätigkeitsbeschreibung" required>
          <input type="date" name="datum" title="Datum" required>
          <input type="time" name="von" title="Von" required>
          <input type="time" name="bis" title="Bis" required>
          <input type="date" name="bis_datum" title="Bis-Datum – nur nötig, wenn die Tätigkeit erst am Folgetag endet">
          <% if (unterprojekte.length > 0) { %>
            <select name="unterprojekt_id" title="Unterprojekt (optional, sonst Allgemein)">
              <option value="">– Allgemein –</option>
              <% unterprojekte.forEach(up => { %>
                <option value="<%= up.id %>"><%= up.title %></option>
              <% }) %>
            </select>
          <% } %>
          <button type="submit" class="btn">Eintragen</button>
          <p class="hint" style="width: 100%; margin: 4px 0 0;">
            Das vierte Feld (Bis-Datum) bleibt normalerweise leer – es wird nur gebraucht, wenn die
            Tätigkeit über Mitternacht hinaus bis in den Folgetag reicht.
          </p>
        </form>
      </section>

      <section class="panel tab-panel" id="tab-import" data-tab-panel <%= activeTab === 'import' ? '' : 'hidden' %>>
        <h2>Zeiten per CSV importieren</h2>
        <p class="hint">
          Spalten (Kopfzeile erforderlich): <code>Datum</code>, <code>Von</code>,
          <code>Bis</code>, <code>Beschreibung</code>. Datum als
          <code>YYYY-MM-DD</code> oder <code>DD.MM.YYYY</code>, Uhrzeiten als
          <code>HH:MM</code>. Komma, Semikolon, Tabulator und Pipe (<code>|</code>)
          werden automatisch als Trennzeichen erkannt.
          Optional <code>Bis-Datum</code> für Tätigkeiten, die erst am Folgetag
          enden, und <code>Unterprojekt</code> (Titel je Zeile; unbekannte
          Angaben landen im auffangenden Unterprojekt). Zeilen mit ungültigem
          Datum oder ungültiger Uhrzeit werden übersprungen und gezählt.
          <% if (unterprojekte.length > 0) { %>
            Hat die Datei keine eigene <code>Unterprojekt</code>-Spalte, gilt
            stattdessen die Auswahl unten für die ganze Datei.
          <% } %>
        </p>
        <form method="post" action="/categories/<%= category.id %>/import" enctype="multipart/form-data" class="inline-form">
          <%- include('partials/csrf') %>
          <input type="file" name="csv_file" accept=".csv,text/csv" required>
          <% if (unterprojekte.length > 0) { %>
            <select name="unterprojekt_id" title="Unterprojekt für Zeilen ohne eigene Unterprojekt-Spalte (sonst Allgemein)">
              <option value="">– Allgemein –</option>
              <% unterprojekte.forEach(up => { %>
                <option value="<%= up.id %>"><%= up.title %></option>
              <% }) %>
            </select>
          <% } %>
          <button type="submit" class="btn">Importieren</button>
        </form>

        <hr>
        <h2>Zeiten als CSV exportieren</h2>
        <p class="hint">
          Exportiert die aktuell unten gefilterten Zeiten dieser Kategorie
          (Beginn, Ende, Dauer, Beschreibung, Unterprojekt, Status) als
          CSV-Datei zum Öffnen in Excel.
        </p>
        <a class="btn"
           href="/categories/<%= category.id %>/export?von=<%= encodeURIComponent(filter.von) %>&bis=<%= encodeURIComponent(filter.bis) %>&suche=<%= encodeURIComponent(filter.suche) %>&sort=<%= filter.sort %>">
          CSV-Export
        </a>
      </section>

      <section class="panel tab-panel" id="tab-unterprojekte" data-tab-panel <%= activeTab === 'unterprojekte' ? '' : 'hidden' %>>
        <h2>Unterprojekte <span class="meta">optional</span></h2>
        <% if (unterprojekte.length > 0) { %>
          <p class="hint">
            Zeiten lassen sich beim Erfassen/Nachtragen einem Unterprojekt zuordnen (sonst landen sie im auffangenden Unterprojekt) und nachträglich über das Aktion-Menü einem anderen zuordnen.
          </p>
          <table class="entries-table" style="margin-bottom: 12px;">
            <tbody>
              <% unterprojekte.forEach(up => { %>
                <tr>
                  <td>
                    <form method="post" action="/unterprojekte/<%= up.id %>/rename" class="inline-form">
                      <%- include('partials/csrf') %>
                      <input type="text" name="title" value="<%= up.title %>" required>
                      <button type="submit" class="link-button">Umbenennen</button>
                    </form>
                  </td>
                  <td class="meta">
                    <%= up.stunden.toFixed(2) %> h<% if (up.ist_auffang) { %> · nimmt Zeiten ohne eigene Zuordnung auf<% } %>
                  </td>
                  <td>
                    <form method="post" action="/unterprojekte/<%= up.id %>/delete" class="inline-form"
                          data-confirm="Unterprojekt &quot;<%= up.title %>&quot; löschen? Die erfassten Zeiten bleiben erhalten.">
                      <%- include('partials/csrf') %>
                      <button type="submit" class="link-button link-button-danger">Löschen</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="hint">
            Beim Löschen bleiben die erfassten Zeiten erhalten: sie wandern in das
            auffangende Unterprojekt – oder werden wieder unzugeordnet, wenn es
            das letzte war.
          </p>
        <% } else { %>
          <p class="hint">
            Noch keine Unterprojekte angelegt. Damit lassen sich die Zeiten dieser Kategorie z. B. nach Kurs oder Teilaufgabe gliedern - ganz optional.
          </p>
        <% } %>
        <form method="post" action="/categories/<%= category.id %>/unterprojekte" class="inline-form">
          <%- include('partials/csrf') %>
          <input type="text" name="title" placeholder="Neues Unterprojekt, z. B. Kurs A" required>
          <button type="submit" class="btn">Anlegen</button>
        </form>
      </section>
    </div>

    <section class="panel">
      <h2>Erfasste Tätigkeiten</h2>
      <p class="hint">Änderungen an Datum, Uhrzeit oder Beschreibung werden sofort gespeichert, sobald das Feld verlassen wird – ein Speichern-Button ist nicht nötig.</p>

      <form method="get" action="/categories/<%= category.id %>" class="entry-form">
        <input type="date" name="von" value="<%= filter.von %>" title="Von Datum">
        <input type="date" name="bis" value="<%= filter.bis %>" title="Bis Datum">
        <input type="text" name="suche" value="<%= filter.suche %>" placeholder="Beschreibung durchsuchen">
        <select name="sort" title="Sortierung" data-submit-on-change>
          <option value="desc" <%= filter.sort === 'desc' ? 'selected' : '' %>>Neueste zuerst</option>
          <option value="asc" <%= filter.sort === 'asc' ? 'selected' : '' %>>Älteste zuerst</option>
        </select>
        <button type="submit" class="btn">Filtern</button>
        <% if (filter.von || filter.bis || filter.suche) { %>
          <a class="btn" href="/categories/<%= category.id %>?sort=<%= filter.sort %>">Zurücksetzen</a>
        <% } %>
      </form>

      <% gruppen.forEach(g => { g.entries.forEach(e => { %>
        <form id="entry-edit-<%= e.id %>" method="post" action="/entries/<%= e.id %>/edit">
          <%- include('partials/csrf') %>
        </form>
      <% }) }) %>

      <% gruppen.forEach(g => { %>
        <% if (g.title) { %>
          <details class="unterprojekt-details" open>
            <summary><%= g.title %> <span class="meta"><%= g.stunden.toFixed(2) %> h</span></summary>
            <%- include('partials/entries-table', { entries: g.entries, filter, unterprojekte }) %>
          </details>
        <% } else { %>
          <%- include('partials/entries-table', { entries: g.entries, filter, unterprojekte }) %>
        <% } %>
      <% }) %>
    </section>
  </main>
  <script src="/public/js/timer.js"></script>
  <script src="/public/js/theme.js"></script>
  <script src="/public/js/forms.js"></script>
  <script src="/public/js/tabs.js"></script>
</body>
</html>
