<!DOCTYPE html>
<html lang="de">
<head>
  <title>Übersicht – Zeiterfassung</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <% if (timer) { %>
      <div class="timer-banner">
        <div>
          <strong>Läuft:</strong> <%= timer.beschreibung %> (<%= timer.category_title %>)
          <span class="live-timer" data-start="<%= timer.start_time %>">00:00:00</span>
        </div>
        <form method="post" action="/entries/<%= timer.id %>/stop">
          <%- include('partials/csrf') %>
          <button type="submit" class="btn btn-stop">Stopp</button>
        </form>
      </div>
    <% } %>

    <div class="page-header">
      <h1>
        Meine Ausgleichsstunden
        <% if (schuljahre.length > 1) { %>
          <form method="get" action="/" class="inline-form schuljahr-wahl">
            <label for="schuljahr-wahl" class="meta">Schuljahr</label>
            <select id="schuljahr-wahl" name="schuljahr" data-submit-on-change>
              <% schuljahre.forEach(sj => { %>
                <option value="<%= sj %>" <%= sj === schuljahr ? 'selected' : '' %>>
                  <%= sj %><%= sj === aktuellesSchuljahr ? ' (laufend)' : '' %>
                </option>
              <% }) %>
            </select>
            <noscript><button type="submit" class="btn">Wechseln</button></noscript>
          </form>
        <% } else { %>
          <span class="meta">Schuljahr <%= schuljahr %></span>
        <% } %>
      </h1>
      <div class="sync-controls">
        <form method="post" action="/settings/auto-sync" class="inline-form">
          <%- include('partials/csrf') %>
          <label class="checkbox">
            <input type="checkbox" name="enabled" data-submit-on-change <%= user.autoSync ? 'checked' : '' %>>
            Automatisch synchronisieren
          </label>
        </form>
        <form method="post" action="/sync" class="inline-form">
          <%- include('partials/csrf') %>
          <button type="submit" class="btn"<%= unsyncedCount === 0 ? ' disabled' : '' %>>
            Jetzt synchronisieren<% if (unsyncedCount > 0) { %> (<%= unsyncedCount %>)<% } %>
          </button>
        </form>
      </div>
    </div>

    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

    <% if (zuweisungenAndereJahre.length > 0) { %>
      <p class="hint">
        Weitere Zuweisungen in anderen Schuljahren:
        <% zuweisungenAndereJahre.forEach((j, i) => { %><%= i > 0 ? ' · ' : '' %><a href="/?schuljahr=<%= encodeURIComponent(j.schuljahr) %>"><%= j.schuljahr %></a> (<%= j.anzahl %><%= j.offen > 0 ? `, ${j.offen} noch nicht verknüpft` : '' %>)<% }) %>
      </p>
    <% } %>

    <% if (zuweisungen.length > 0) { %>
      <section class="panel">
        <h2>Meine Ausgleichsstunden-Zuweisungen <span class="meta">Schuljahr <%= schuljahr %></span></h2>
        <p class="hint">
          Von der Schulleitung zugewiesene Ausgleichsstunden. Verknüpfe sie mit
          einer eigenen Kategorie oder übernimm sie als neue Kategorie – ein
          Vorschlag muss immer von der Schulleitung bestätigt werden, bevor er
          gilt. Solange für die Kategorie noch keine Zeiten erfasst wurden,
          lässt sich die Verknüpfung noch per neuem Vorschlag ändern.
        </p>
        <% zuweisungen.forEach(z => { %>
          <div class="zuweisung-item">
            <p class="zuweisung-meta">
              <strong><%= z.ausgleichsstunden %></strong> Ausgleichsstunden
              <% if (z.faktor) { %>
                × Faktor <strong><%= z.faktor %></strong> = <%= (z.ausgleichsstunden * z.faktor).toFixed(2) %> Zeitstunden
              <% } %>
              <span class="meta">(Schuljahr <%= z.schuljahr %>)</span>
            </p>
            <% if (!z.faktor) { %>
              <p class="hint">
                Wie viele Zeitstunden das sind, steht noch nicht fest – für das Schuljahr
                <%= z.schuljahr %> hat die Schulleitung Zeitstunden pro Woche und Schulwochen
                noch nicht festgelegt.
              </p>
            <% } %>

            <% if (z.category_title) { %>
              <p class="zuweisung-meta">
                Verknüpft mit: <strong><%= z.category_title %></strong>
                <% if (z.gesperrt) { %><span class="hint">(fest, da bereits Zeiten erfasst)</span><% } %>
              </p>
            <% } %>

            <% if (z.vorschlag_von === 'admin') { %>
              <p class="hint">
                Vorschlag der Schulleitung: <strong><%= z.vorschlag_category_title || '– Verknüpfung aufheben –' %></strong>
              </p>
              <div class="zuweisung-actions">
                <form method="post" action="/zuweisungen/<%= z.id %>/annehmen" class="inline-form">
                  <%- include('partials/csrf') %>
                  <button type="submit" class="btn btn-start">Annehmen</button>
                </form>
                <form method="post" action="/zuweisungen/<%= z.id %>/ablehnen" class="inline-form">
                  <%- include('partials/csrf') %>
                  <button type="submit" class="link-button link-button-danger">Ablehnen</button>
                </form>
              </div>
            <% } else if (z.vorschlag_von === 'lehrkraft') { %>
              <p class="hint">
                Dein Vorschlag (<%= z.vorschlag_category_title || '– Verknüpfung aufheben –' %>) wartet auf Bestätigung durch die Schulleitung.
              </p>
            <% } else if (!z.gesperrt) { %>
              <div class="zuweisung-actions">
                <form method="post" action="/zuweisungen/<%= z.id %>/link" class="inline-form">
                  <%- include('partials/csrf') %>
                  <select name="category_id">
                    <option value="">– keine Verknüpfung –</option>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat.id %>" <%= z.category_id === cat.id ? 'selected' : '' %>><%= cat.title %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn"><%= z.category_id ? 'Änderung vorschlagen' : 'Vorschlagen' %></button>
                </form>
                <% if (!z.category_id) { %>
                  <form method="post" action="/zuweisungen/<%= z.id %>/uebernehmen" class="inline-form">
                    <%- include('partials/csrf') %>
                    <input type="text" name="title" placeholder="Titel für neue Kategorie (optional)">
                    <button type="submit" class="btn btn-start">Übernehmen</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </section>
    <% } %>

    <section class="panel">
      <h2>Neue Kategorie anlegen <span class="meta">für <%= schuljahr %></span></h2>
      <form method="post" action="/categories" class="inline-form">
        <%- include('partials/csrf') %>
        <input type="hidden" name="schuljahr" value="<%= schuljahr %>">
        <input type="text" name="title" placeholder="z. B. Administration Moodle" required>
        <input type="number" name="ziel_zeitstunden" placeholder="Ziel-Zeitstunden (optional)" step="0.25" min="0.25">
        <button type="submit" class="btn btn-start">Anlegen</button>
      </form>
    </section>

    <% if (categories.length === 0) { %>
      <p class="empty-state">Noch keine Kategorien für <%= schuljahr %> angelegt.</p>
    <% } %>

    <div class="card-grid">
      <% categories.forEach(cat => { %>
        <a class="card" href="/categories/<%= cat.id %>">
          <h2><%= cat.title %></h2>
          <% if (cat.ziel.stunden !== null) { %>
            <div class="progress">
              <div class="progress-bar" style="width: <%= cat.fortschritt %>%"></div>
            </div>
            <p class="progress-label"><%= cat.erfassteStunden.toFixed(2) %> von <%= cat.ziel.stunden.toFixed(2) %> Zeitstunden erfasst</p>
          <% } else { %>
            <p class="progress-label"><%= cat.erfassteStunden.toFixed(2) %> Zeitstunden erfasst</p>
            <p class="hint" style="margin: 0;">
              <%= cat.ziel.quelle === 'kein-faktor' ? 'Ziel noch offen (Faktor fehlt)' : 'Noch kein Ziel hinterlegt' %>
            </p>
          <% } %>
        </a>
      <% }) %>
    </div>
  </main>
  <script src="/public/js/timer.js"></script>
  <script src="/public/js/theme.js"></script>
  <script src="/public/js/forms.js"></script>
</body>
</html>
