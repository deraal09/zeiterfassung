<!DOCTYPE html>
<html lang="de">
<head>
  <title>Anmelden – Zeiterfassung</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Anmelden</h1>
    <p class="hint">Anmeldung mit dem Schulaccount.</p>
    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <form method="post" action="/login" class="form-karte">
      <%- include('partials/csrf') %>
      <label for="username">Benutzername
        <input type="text" id="username" name="username" autocomplete="username" required autofocus>
      </label>
      <label for="password">Passwort
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </label>
      <button type="submit" class="btn btn-start btn-block">Anmelden</button>
    </form>
  </main>
  <%- include('partials/footer') %>
  <script src="/public/js/theme.js?v=<%= assetVersion %>"></script>
  <script src="/public/js/pwa.js?v=<%= assetVersion %>"></script>
</body>
</html>
