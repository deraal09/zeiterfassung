<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= user && user.isAdmin ? '/admin' : '/' %>">Zeiterfassung</a>
    <% if (user) { %>
      <nav class="nav-links">
        <% if (user.isAdmin) { %>
          <a href="/admin">Admin</a>
          <a href="/">Meine Zeiten</a>
        <% } else { %>
          <a href="/">Übersicht</a>
        <% } %>
        <span class="nav-user"><%= user.displayName %></span>
        <form action="/logout" method="post" class="inline-form">
          <%- include('csrf') %>
          <button type="submit" class="link-button">Abmelden</button>
        </form>
        <%- include('pwa-install') %>
        <%- include('theme-toggle') %>
      </nav>
    <% } else { %>
      <div class="nav-links">
        <%- include('pwa-install') %>
        <%- include('theme-toggle') %>
      </div>
    <% } %>
  </div>
</header>
<% if (user && user.isAdmin && typeof poolBadge !== 'undefined' && poolBadge) { %>
  <%# Gesamtpool des gewaehlten Schuljahres - auf jeder Seite oben rechts. %>
  <div class="pool-leiste">
    <a class="pool-badge" href="/admin/pools?schuljahr=<%= encodeURIComponent(poolBadge.schuljahr) %>"
       title="Zu den Pools des Schuljahres <%= poolBadge.schuljahr %>">
      <% if (poolBadge.anzahl === 0) { %>
        <span class="pool-badge-label">Gesamtpool <%= poolBadge.schuljahr %></span>
        <strong>noch kein Pool angelegt</strong>
      <% } else { %>
        <span class="pool-badge-label">Gesamtpool <%= poolBadge.schuljahr %></span>
        <strong><%= zahl(poolBadge.stunden) %> h</strong>
        <span class="pool-badge-teil"><%= zahl(poolBadge.vergeben) %> vergeben</span>
        <span class="pool-badge-teil"><%= zahl(poolBadge.frei) %> frei</span>
      <% } %>
    </a>
  </div>
<% } %>
